# Copia este archivo a ".env" y ajusta los valores antes de arrancar el servidor.

# Credenciales del único usuario admin (se usan solo la primera vez que se crea data/db.json).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave

# Cadena secreta para firmar la cookie de sesión. Usa un valor largo y aleatorio en producción.
SESSION_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

PORT=4000
NODE_ENV=development

# PayPal: "sb" es el client-id de pruebas oficial de PayPal, sirve para
# probar el flujo de pago sin cuenta real. Cámbialo por tu client-id real
# (público, no es secreto) cuando quieras cobros de verdad.
PAYPAL_CLIENT_ID=sb
PAYPAL_CURRENCY=EUR

# Sin esto el servidor NO verifica los pagos con la API de PayPal (queda en
# modo demo, confía en lo que dice el navegador). Se obtiene junto al
# client-id real en developer.paypal.com — este SÍ es secreto, nunca lo subas
# a GitHub ni lo compartas.
PAYPAL_CLIENT_SECRET=

# "sandbox" mientras pruebes (client-id/secret de prueba de PayPal). Cambia a
# "live" solo cuando uses las credenciales reales de tu cuenta Business.
PAYPAL_ENV=sandbox

# Emails (confirmación de cuenta y newsletter) vía Resend (resend.com). Sin
# RESEND_API_KEY no se envía nada: el enlace queda escrito en la consola del
# servidor para probar a mano. Es SECRETO: nunca lo subas a GitHub.
RESEND_API_KEY=
# Remitente verificado en Resend, ej. "RAWGAT <hola@rawgat.com>".
EMAIL_FROM=
